NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://api.example.com
# Comma-separated exact proxy IP/CIDRs; empty when not behind a proxy.
TRUST_PROXY=
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=betterseed
MYSQL_USER=betterseed
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
# openssl rand -hex 32 for EACH; keep stable and back up securely.
TOKEN_PEPPER=REPLACE_WITH_64_HEX_CHARACTERS
DATA_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
GOOGLE_WEB_CLIENT_ID=
GOOGLE_PLAY_PACKAGE_NAME=com.betterseed.app
# Leave empty until Google Play credentials and products are ready.
# Then use /run/secrets/google-play.json
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_RTDN_AUDIENCE=https://api.example.com/v1/billing/notifications
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=
GMAIL_RELAY_BASE_URL=https://gmailrelay.vercel.app
GMAIL_RELAY_API_KEY=
LEGAL_OPERATOR_NAME=
SUPPORT_EMAIL=
# YYYY-MM-DD; version recorded when the user accepts terms.
LEGAL_VERSION=2026-10-28

# Native VPS: loopback. Docker compose overrides this to 0.0.0.0.
HOST=127.0.0.1

# Docker only: retain the image/version already used by your database volume.
# Existing MySQL 8.0.46 deployments: set mysql:8.0.46 before Compose commands.
MYSQL_IMAGE=mysql:8.4
